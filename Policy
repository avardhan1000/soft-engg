<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Online Insurance Policy System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f4f7fc;
}

header{
    background:#003366;
    color:white;
    padding:15px 40px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

header h1{
    font-size:28px;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:20px;
    font-weight:bold;
}

.hero{
    text-align:center;
    padding:100px 20px;
    background:linear-gradient(to right,#003366,#00509d);
    color:white;
}

.hero h2{
    font-size:40px;
    margin-bottom:15px;
}

.hero p{
    font-size:18px;
    margin-bottom:20px;
}

.btn{
    padding:12px 25px;
    background:white;
    color:#003366;
    border:none;
    border-radius:5px;
    cursor:pointer;
    font-weight:bold;
}

section{
    padding:50px 20px;
}

.section-title{
    text-align:center;
    margin-bottom:30px;
    color:#003366;
}

.cards{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:20px;
}

.card{
    background:white;
    width:300px;
    padding:20px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,0.1);
    text-align:center;
}

.card h3{
    color:#003366;
    margin-bottom:10px;
}

.card button{
    margin-top:15px;
    background:#00509d;
    color:white;
    border:none;
    padding:10px 20px;
    border-radius:5px;
    cursor:pointer;
}

.form-container{
    max-width:500px;
    margin:auto;
    background:white;
    padding:30px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,0.1);
}

input, select{
    width:100%;
    padding:12px;
    margin:10px 0;
    border:1px solid #ccc;
    border-radius:5px;
}

.submit-btn{
    width:100%;
    background:#003366;
    color:white;
    border:none;
    padding:12px;
    border-radius:5px;
    cursor:pointer;
}

.dashboard{
    max-width:900px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.dashboard-card{
    background:white;
    padding:20px;
    border-radius:10px;
    text-align:center;
    box-shadow:0 0 10px rgba(0,0,0,0.1);
}

footer{
    background:#003366;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:30px;
}

#message{
    margin-top:15px;
    text-align:center;
    color:green;
    font-weight:bold;
}

@media(max-width:768px){
    header{
        flex-direction:column;
    }

    nav{
        margin-top:10px;
    }
}
</style>
</head>

<body>

<header>
    <h1>SecureLife Insurance</h1>

    <nav>
        <a href="#home">Home</a>
        <a href="#plans">Plans</a>
        <a href="#purchase">Buy Policy</a>
        <a href="#dashboard">Dashboard</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section class="hero" id="home">
    <h2>Protect What Matters Most</h2>
    <p>Simple, Fast and Secure Insurance Policies</p>

    <button class="btn"
    onclick="document.getElementById('plans').scrollIntoView({behavior:'smooth'})">
    View Plans
    </button>
</section>

<section id="plans">
    <h2 class="section-title">Insurance Plans</h2>

    <div class="cards">

        <div class="card">
            <h3>Life Insurance</h3>
            <p>Coverage up to ₹50 Lakhs</p>
            <button onclick="selectPlan('Life Insurance')">
                Select Plan
            </button>
        </div>

        <div class="card">
            <h3>Health Insurance</h3>
            <p>Cashless Hospitalization</p>
            <button onclick="selectPlan('Health Insurance')">
                Select Plan
            </button>
        </div>

        <div class="card">
            <h3>Vehicle Insurance</h3>
            <p>Comprehensive Vehicle Protection</p>
            <button onclick="selectPlan('Vehicle Insurance')">
                Select Plan
            </button>
        </div>

    </div>
</section>

<section id="purchase">
    <h2 class="section-title">Purchase Policy</h2>

    <div class="form-container">

        <form id="insuranceForm">

            <input type="text"
            placeholder="Full Name"
            required>

            <input type="email"
            placeholder="Email Address"
            required>

            <input type="number"
            placeholder="Age"
            required>

            <select id="policySelect" required>
                <option value="">Select Policy</option>
                <option>Life Insurance</option>
                <option>Health Insurance</option>
                <option>Vehicle Insurance</option>
            </select>

            <button class="submit-btn">
                Submit Application
            </button>

        </form>

        <p id="message"></p>

    </div>
</section>

<section id="dashboard">
    <h2 class="section-title">Customer Dashboard</h2>

    <div class="dashboard">

        <div class="dashboard-card">
            <h3>Active Policies</h3>
            <p>3</p>
        </div>

        <div class="dashboard-card">
            <h3>Total Coverage</h3>
            <p>₹75 Lakhs</p>
        </div>

        <div class="dashboard-card">
            <h3>Premium Due</h3>
            <p>₹2,500</p>
        </div>

    </div>
</section>

<section id="contact">
    <h2 class="section-title">Contact Us</h2>

    <div style="text-align:center;">
        <p>Email: support@securelife.com</p>
        <br>
        <p>Phone: +91 9876543210</p>
    </div>
</section>

<footer>
    <p>© 2026 SecureLife Insurance System</p>
</footer>

<script>

function selectPlan(plan){
    document.getElementById("policySelect").value = plan;

    document.getElementById("purchase")
    .scrollIntoView({
        behavior:"smooth"
    });
}

document.getElementById("insuranceForm")
.addEventListener("submit", function(e){

    e.preventDefault();

    document.getElementById("message")
    .innerHTML =
    "✔ Policy application submitted successfully!";
});

</script>

</body>
</html>
